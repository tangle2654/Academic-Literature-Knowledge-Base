{
  "name": "academic-knowledge-base",
  "version": "1.0.0",
  "description": "多用户学术文献知识库 - 支持文献检索订阅、个人知识库、公众号收藏等",
  "main": "backend/server.js",
  "scripts": {
    "install": "node -e \"const cp=require('child_process');cp.execSync('cd frontend && npm install --no-audit --no-fund',{stdio:'inherit'})\"",
    "build": "cd frontend && npm install --no-audit --no-fund && npm run build",
    "start": "node backend/server.js",
    "dev": "node backend/server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "better-sqlite3": "^11.1.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
